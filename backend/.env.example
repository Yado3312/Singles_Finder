# Export these variables before running the Go server.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=singlesfinder
# Set true for the first run only to insert fictional profiles into an empty collection.
SEED_DEMO=true
ADDR=127.0.0.1:8080
# Atlas alternative (replace placeholders in your local environment only):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.gjyyl6k.mongodb.net/
